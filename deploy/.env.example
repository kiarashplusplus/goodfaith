# docker compose settings (copy to deploy/.env). NEXT_PUBLIC_* are baked into the app image at build time.
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_POOL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_POOL_AUTHORITY=
NEXT_PUBLIC_GATEKEEPER_NETWORK=
GOODFAITH_VERSION=
# Kora (the sponsor keypair as a JSON array; prefer a Turnkey/Privy signer for hosting) and the proxy's credentials
KORA_PRIVATE_KEY=
KORA_API_KEY=
KORA_HMAC_SECRET=
# Identity service
IDENTITY_PROVIDER=persona
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=
PERSON_HASH_SECRETS=1:
ISSUER_SECRET=
GATEKEEPER_SECRET=
# The recovery key is NOT given to the app: the operator runs `npm run recovery` (scripts/recovery.ts) with RECOVERY_KEYPAIR.
# Where member notices go (recovery requests, bars) as JSON POSTs; the server log when empty
NOTIFY_WEBHOOK_URL=
RECOVERY_MIN_AGE_SECONDS=
IDENTITY_ADMIN_KEY=
# Postgres instead of the SQLite volume (start with --profile postgres): postgres://goodfaith:<password>@postgres:5432/goodfaith
IDENTITY_DB_URL=
# MoneyGram Ramps cash access (optional; empty hides the cash card). The origin is public and baked into the image;
# the secret key is server-only. Sandbox: https://playground.xramps.moneygram.com and a ramps_sk_sbox_ key, devnet only.
NEXT_PUBLIC_RAMPS_ORIGIN=
MONEYGRAM_SK=
MONEYGRAM_SESSIONS_URL=
POSTGRES_PASSWORD=
# Sponsorship allowance per wallet, and the fund-wide daily budget (transactions, wallets sponsored for the first time)
SPONSOR_DAILY_TX_PER_WALLET=40
SPONSOR_ATA_PER_WALLET=12
SPONSOR_DAILY_BUDGET_TX=2000
SPONSOR_DAILY_NEW_WALLETS=200
# Cranker
CRANKER_KEYPAIR_FILE=./cranker.json
CRANKER_INTERVAL=300
