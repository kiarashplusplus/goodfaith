NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_POOL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_PROGRAM_ID=BM71D4Kdnq3Mtc2cqDuMBLyYguFihDqsjk9btdTWtoRd
# Fee sponsor (Kora). Leave empty to have users pay their own network fees and rent.
# Development: the Kora server itself, e.g. http://127.0.0.1:8080
# Hosting: this app's proxy, which holds the credentials below and limits clients
NEXT_PUBLIC_KORA_URL=
# Server only (never NEXT_PUBLIC_): where the proxy forwards to, and Kora's auth (KORA_API_KEY and/or KORA_HMAC_SECRET)
KORA_URL=
KORA_API_KEY=
KORA_HMAC_SECRET=
# Civic gatekeeper network (public key) required for members
NEXT_PUBLIC_GATEKEEPER_NETWORK=
# Pin the canonical pool (anyone can create a pool for a mint). Address defaults to the PDA for the mint.
NEXT_PUBLIC_POOL_ADDRESS=
# Required: expected pool authority address, or "none" if the pool is frozen
NEXT_PUBLIC_POOL_AUTHORITY=
