NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_POOL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_PROGRAM_ID=BM71D4Kdnq3Mtc2cqDuMBLyYguFihDqsjk9btdTWtoRd
# Fee sponsor (Kora). Leave empty to have users pay their own network fees and rent.
# Development: the Kora server itself, e.g. http://127.0.0.1:8080
# Hosting: this app's proxy, which holds the credentials below and limits clients
NEXT_PUBLIC_KORA_URL=
# Server only (never NEXT_PUBLIC_): where the proxy forwards to, and Kora's auth (KORA_API_KEY and/or KORA_HMAC_SECRET)
KORA_URL=
KORA_API_KEY=
KORA_HMAC_SECRET=
# The fund's own gatekeeper network (public key) on the Identity.com gateway program; `scripts: npm run gatekeeper-setup`
NEXT_PUBLIC_GATEKEEPER_NETWORK=
# Identity issuer service (server only). Provider: persona (production) or mock (test networks and CI).
IDENTITY_PROVIDER=persona
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=
# Keyed fingerprint of the verified ID fields: one person, one membership. To rotate, list the keys newest first as
# "version:secret" pairs in PERSON_HASH_SECRETS ("2:new,1:old"); people are re-linked under the new key on their next
# check and the old key can be dropped later. PERSON_HASH_SECRET alone is version 1.
PERSON_HASH_SECRET=
PERSON_HASH_SECRETS=
# Keypairs as JSON arrays (solana-keygen format). The issuer must equal the pool's `issuer`; the gatekeeper must be on the
# network. The recovery key never lives here: the operator's `npm run recovery` CLI holds it (RECOVERY_KEYPAIR) and signs
# the proposals this service prepares.
ISSUER_SECRET=
GATEKEEPER_SECRET=
# Where member notices go (recovery requested, proposed or rejected; bars set or lifted) as JSON POSTs. Empty: the log.
NOTIFY_WEBHOOK_URL=
# How long a wallet-recovery request must have been open before the operator's CLI may propose it (seconds; default one day).
RECOVERY_MIN_AGE_SECONDS=
# SQLite file for the identity registry and the sponsor counters ("memory" for a throwaway store), or a Postgres URL
# (IDENTITY_DB_URL wins when set; needed when more than one app instance runs)
IDENTITY_DB_PATH=./identity.sqlite
IDENTITY_DB_URL=
# Shared secret for the operator routes: POST /api/identity/ban (the cranker, the admin CLI) and /api/identity/recoveries (the recovery CLI)
IDENTITY_ADMIN_KEY=
# Sponsorship allowance per wallet (transactions per UTC day, token accounts created in total) and the fund-wide daily
# budget (transactions, wallets sponsored for the first time)
SPONSOR_DAILY_TX_PER_WALLET=40
SPONSOR_ATA_PER_WALLET=12
SPONSOR_DAILY_BUDGET_TX=2000
SPONSOR_DAILY_NEW_WALLETS=200
# Pin the canonical pool (anyone can create a pool for a mint). Address defaults to the PDA for the mint.
NEXT_PUBLIC_POOL_ADDRESS=
# Required: expected pool authority address, or "none" if the pool is frozen
NEXT_PUBLIC_POOL_AUTHORITY=
